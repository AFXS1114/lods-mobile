{
  "expo": {
    "name": "LODS Mobile",
    "slug": "lods-mobile2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/lods-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lods.mobile2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LODS needs your location to track deliveries in real time.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "LODS needs your location in the background to keep tracking your delivery route."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/lods-logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.lods.mobile2",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/lods-logo.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LODS needs your location to track your delivery route.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/lods-logo.png",
          "color": "#9A66FF",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/lods-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "78d2e3d7-d0d9-4c4b-a103-f2ed5f389b05"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/78d2e3d7-d0d9-4c4b-a103-f2ed5f389b05"
    }
  }
}
