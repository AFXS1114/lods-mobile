{
  "expo": {
    "name": "LODS Mobile",
    "slug": "lods-mobile2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lods.mobile2",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "LODS needs your location to track deliveries in real time.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "LODS needs your location in the background to keep tracking your delivery route."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1117"
      },
      "package": "com.lods.mobile2",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LODS needs your location to track your delivery route.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF6B35",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "78d2e3d7-d0d9-4c4b-a103-f2ed5f389b05"
      }
    }
  }
}